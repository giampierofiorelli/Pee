{
 "schema": "pee.product-functions.v1",
 "version": "pf.2",
 "statement": "FC (2026-10-18): reading vocabulary for what a product can do (functions), with what (components) and in which state (operating modes and settings), kept apart from metrics, results and qualitative observations. PEE's reading vocabulary (source 'pee'), never product facts. A function's presence is categorical (available / not available / not verified) and never evidence of how well it works; the evidence that would show effectiveness is named per function. pf.2 (2026-10-18, after the first run): a mode with a purpose realises a function (laundry mode realises laundry drying), and a statement about how a component or a mode behaves is evidence about the function it enables or realises.",
 "sources": [
  {
   "id": "pee",
   "title": "PEE reading vocabulary",
   "use": "terms and cues"
  },
  {
   "id": "jcgm_vim",
   "title": "JCGM 200:2012 International vocabulary of metrology (VIM), 3rd edition",
   "url": "https://www.bipm.org/en/committees/jc/jcgm/publications",
   "use": "measurand (2.3), influence quantity (2.52), rated operating condition (4.9), reference operating condition (4.11): a setting under which a value is obtained is part of the measurement's specification, not of the metric"
  },
  {
   "id": "w3c_sosa_ssn",
   "title": "W3C/OGC Semantic Sensor Network Ontology (SOSA/SSN)",
   "url": "https://www.w3.org/TR/vocab-ssn/",
   "use": "Observation (made by a Procedure, has a Result, observes a Property of a FeatureOfInterest) is distinct from Actuation (an Actuator acts on a Property): a mode is an actuation state, a result an observation"
  },
  {
   "id": "schema_org",
   "title": "Schema.org PropertyValue, QualitativeValue, QuantitativeValue, valueReference",
   "url": "https://schema.org/PropertyValue",
   "use": "categorical (qualitative, enumerated) values are distinct from quantitative values with units; valueReference carries the context of a value"
  },
  {
   "id": "energystar_air_cleaner",
   "title": "ENERGY STAR Room Air Cleaners specification and test method",
   "url": "https://www.energystar.gov/products/room_air_cleaners",
   "use": "purifiers are evaluated by CADR, power and efficiency under defined methods; a feature's presence is not part of the performance evaluation"
  }
 ],
 "classes": [
  {
   "id": "function",
   "statement": "something the product can do; presence is categorical (available, not_available, not_verified) and comes with who states it",
   "source": "pee"
  },
  {
   "id": "component",
   "statement": "a physical part that may enable a function or serve a property; its presence does not establish the function or its effectiveness",
   "source": "w3c_sosa_ssn"
  },
  {
   "id": "mode",
   "statement": "a selectable operating state or setting (an actuation state): nominal (sleep, turbo), ordinal (speed 1 of 4, lowest), a numeric setting (60 °C) or a programme (Eco); two mode names are the same state only when a document states it for that product",
   "source": "w3c_sosa_ssn"
  },
  {
   "id": "test_condition",
   "statement": "a condition under which a value was obtained: an operating mode, a test material, the environment or the procedure",
   "source": "jcgm_vim"
  },
  {
   "id": "metric",
   "statement": "a measurable quantity defined by a method (CADR, A-weighted sound level at a distance); held in the quantity knowledge",
   "source": "jcgm_vim"
  },
  {
   "id": "result",
   "statement": "a value of a metric for a product under stated conditions, with its evidence class",
   "source": "w3c_sosa_ssn"
  },
  {
   "id": "observation",
   "statement": "an expert qualitative statement (structured qualitative evidence); a function's availability is not an observation",
   "source": "pee"
  }
 ],
